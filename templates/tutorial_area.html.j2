<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ area.display_name }} — Interactive Tutorials</title>
  <meta name="description" content="Interactive {{ area.display_name }} tutorials powered by marimo and WebAssembly.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-color: #FBFAF4;
      --text-main: #091717;
      --text-muted: #526668;
      --primary: #20808D;
      --primary-hover: #20B8CD;
      --callout-header: #BADFDE;
      --border-color: #2CA0AB;
      --card-bg: #FBFAF4;
      --card-hover-bg: #FFFFFF;
      --pill-bg: #DEF7F9;
      --shadow-sm: 0 4px 12px rgba(32, 128, 141, 0.06);
      --shadow-hover: 0 12px 28px -6px rgba(32, 128, 141, 0.16);
      --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--font-family);
      line-height: 1.6;
      color: var(--text-main);
      background-color: var(--bg-color);
      padding: 30px 20px;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .container { max-width: 1080px; margin: 0 auto; width: 100%; }

    .back-nav {
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 600;
      color: var(--primary);
      text-decoration: none;
      padding: 6px 14px;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      background-color: #FBFAF4;
      transition: all 0.2s ease;
    }

    .back-link:hover {
      background-color: var(--primary);
      color: #FBFAF4;
    }

    header.hero-banner {
      background: linear-gradient(145deg, #FBFAF4 0%, #F1FAF9 100%);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 34px 32px;
      text-align: center;
      margin-bottom: 30px;
      box-shadow: var(--shadow-sm);
      position: relative;
      overflow: hidden;
    }

    header.hero-banner::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 5px;
      background: linear-gradient(90deg, var(--primary) 0%, var(--primary-hover) 100%);
    }

    .wasm-badge {
      background-color: var(--callout-header);
      color: var(--text-main);
      font-size: 12px;
      font-weight: 600;
      padding: 4px 12px;
      border-radius: 20px;
      letter-spacing: 0.3px;
      border: 1px solid rgba(32, 128, 141, 0.2);
      display: inline-block;
      margin-bottom: 10px;
    }

    h1.hero-title {
      font-size: 28px;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 8px;
      letter-spacing: -0.5px;
    }

    p.subtitle {
      font-size: 15px;
      color: var(--text-muted);
      max-width: 680px;
      margin: 0 auto;
    }

    .controls-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      margin-bottom: 28px;
      padding: 12px 18px;
      background-color: #FBFAF4;
      border: 1px solid var(--border-color);
      border-radius: 12px;
    }

    .search-box { position: relative; flex: 1; }
    .search-box input {
      width: 100%;
      padding: 8px 14px 8px 36px;
      font-size: 14px;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      background-color: #FBFAF4;
      color: var(--text-main);
      font-family: inherit;
      outline: none;
    }
    .search-box input:focus {
      border-color: var(--primary-hover);
      box-shadow: 0 0 0 3px rgba(32, 184, 205, 0.2);
    }
    .search-box svg {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      width: 16px;
      height: 16px;
      fill: var(--primary);
    }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 22px;
      margin-bottom: 40px;
    }

    .quarto-grid-item.card {
      background-color: var(--card-bg);
      border-radius: 12px;
      border: 1px solid var(--border-color);
      transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .quarto-grid-item.card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-hover);
      background-color: var(--card-hover-bg);
      border-color: var(--primary-hover);
    }

    .card-header-bar {
      background-color: rgba(186, 223, 222, 0.35);
      border-bottom: 1px solid rgba(44, 160, 171, 0.3);
      padding: 12px 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .card-title { font-size: 17px; font-weight: 700; color: var(--text-main); }
    .card-type-tag {
      font-size: 11px; font-weight: 600; text-transform: uppercase;
      letter-spacing: 0.5px; color: var(--primary);
    }

    .card-body {
      padding: 20px 18px;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .card-text { font-size: 14px; color: var(--text-muted); margin-bottom: 20px; }

    .btn-filled-primary {
      background-color: #20808D !important;
      color: #FBFAF4 !important;
      border: 1px solid #20808D !important;
      border-radius: 6px;
      padding: 8px 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-weight: 600;
      font-size: 13px;
      text-decoration: none !important;
      transition: all 0.2s ease-in-out;
      cursor: pointer;
      width: 100%;
    }

    .btn-filled-primary:hover {
      background-color: #20B8CD !important;
      border-color: #20B8CD !important;
    }

    .btn-filled-primary svg { fill: #FBFAF4 !important; }

    footer {
      background-color: #FBFAF4;
      border-top: 1px solid var(--border-color);
      text-align: center;
      padding: 24px 0 10px;
      margin-top: auto;
      font-size: 13px;
      color: var(--text-muted);
    }

    footer a { color: #20808D; text-decoration: none; }
    footer a:hover { text-decoration: underline; }
    .empty-state { display: none; text-align: center; padding: 40px 20px; color: var(--text-muted); }
  </style>
</head>
<body>
  <div class="container">
    <div class="back-nav">
      <a href="../../index.html" class="back-link">← Back to All Tutorials &amp; Apps</a>
    </div>

    <header class="hero-banner">
      <span class="wasm-badge">Tutorial Area · Run Mode</span>
      <h1 class="hero-title">{{ area.display_name }}</h1>
      <p class="subtitle">Interactive tutorial notebooks in app mode — explore theory, worked examples, and live sliders without code clutter.</p>
    </header>

    <div class="controls-bar">
      <div class="search-box">
        <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
        <input type="text" id="search-input" placeholder="Search {{ area.display_name | lower }} tutorials...">
      </div>
    </div>

    <main>
      <div class="cards-grid">
        {% for item in area.tutorials %}
        <div class="quarto-grid-item card item-card" data-title="{{ item.display_name | lower }}">
          <div class="card-header-bar">
            <span class="card-title">{{ item.display_name }}</span>
            <span class="card-type-tag">Tutorial App</span>
          </div>
          <div class="card-body">
            <p class="card-text">Interactive tutorial in clean presentation / app mode.</p>
            <a href="{{ item.html_filename }}" class="btn-filled-primary">
              <svg width="14" height="14" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              Launch Tutorial
            </a>
          </div>
        </div>
        {% endfor %}
      </div>

      <div class="empty-state" id="empty-state">
        <p>No tutorials matched your search query.</p>
      </div>
    </main>

    <footer>
      <p>Built with <a href="https://marimo.io" target="_blank">marimo</a> &amp; WebAssembly — Interactive Python Tutorials</p>
    </footer>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const searchInput = document.getElementById('search-input');
      const cards = document.querySelectorAll('.item-card');
      const emptyState = document.getElementById('empty-state');
      if (searchInput) {
        searchInput.addEventListener('input', function(e) {
          const q = e.target.value.trim().toLowerCase();
          let visible = 0;
          cards.forEach(card => {
            const match = card.getAttribute('data-title').includes(q);
            card.style.display = match ? 'flex' : 'none';
            if (match) visible++;
          });
          if (emptyState) emptyState.style.display = visible === 0 ? 'block' : 'none';
        });
      }
    });
  </script>
</body>
</html>
