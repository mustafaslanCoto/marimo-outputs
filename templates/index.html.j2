<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interactive Notebooks & Applications</title>
  <meta name="description" content="Interactive Python notebooks, slides, and WebAssembly applications powered by marimo.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-color: #FBFAF4;
      --text-main: #091717;
      --text-muted: #526668;
      --primary: #20808D;
      --primary-hover: #20B8CD;
      --nav-hover: #1FB8CD;
      --callout-header: #BADFDE;
      --border-color: #2CA0AB;
      --card-bg: #FBFAF4;
      --card-hover-bg: #FFFFFF;
      --pill-bg: #DEF7F9;
      --shadow-sm: 0 4px 12px rgba(32, 128, 141, 0.06);
      --shadow-hover: 0 12px 28px -6px rgba(32, 128, 141, 0.16);
      --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-family);
      line-height: 1.6;
      color: var(--text-main);
      background-color: var(--bg-color);
      padding: 30px 20px;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .container {
      max-width: 1080px;
      margin: 0 auto;
      width: 100%;
    }

    /* --- Hero Header --- */
    header.hero-banner {
      background: linear-gradient(145deg, #FBFAF4 0%, #F1FAF9 100%);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 40px 36px;
      text-align: center;
      margin-bottom: 36px;
      box-shadow: var(--shadow-sm);
      position: relative;
      overflow: hidden;
    }

    header.hero-banner::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 5px;
      background: linear-gradient(90deg, var(--primary) 0%, var(--primary-hover) 100%);
    }

    .brand-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-bottom: 16px;
    }

    .logo {
      height: 38px;
      width: auto;
    }

    .wasm-badge {
      background-color: var(--callout-header);
      color: var(--text-main);
      font-size: 12px;
      font-weight: 600;
      padding: 4px 12px;
      border-radius: 20px;
      letter-spacing: 0.3px;
      border: 1px solid rgba(32, 128, 141, 0.2);
    }

    h1.hero-title {
      font-size: 30px;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 8px;
      letter-spacing: -0.5px;
    }

    p.subtitle {
      font-size: 16px;
      color: var(--text-muted);
      max-width: 680px;
      margin: 0 auto 20px;
      font-weight: 400;
    }

    .features-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      margin-top: 16px;
    }

    .feature-pill {
      background-color: var(--pill-bg);
      color: var(--primary);
      border: 1px solid rgba(44, 160, 171, 0.3);
      font-size: 13px;
      font-weight: 500;
      padding: 5px 14px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    /* --- Search & Filter Controls --- */
    .controls-bar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      margin-bottom: 30px;
      padding: 12px 18px;
      background-color: #FBFAF4;
      border: 1px solid var(--border-color);
      border-radius: 12px;
    }

    .search-box {
      position: relative;
      flex: 1;
      min-width: 240px;
    }

    .search-box input {
      width: 100%;
      padding: 8px 14px 8px 36px;
      font-size: 14px;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      background-color: #FBFAF4;
      color: var(--text-main);
      font-family: inherit;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .search-box input:focus {
      border-color: var(--primary-hover);
      box-shadow: 0 0 0 3px rgba(32, 184, 205, 0.2);
    }

    .search-box svg {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      width: 16px;
      height: 16px;
      fill: var(--primary);
    }

    .filter-tabs {
      display: flex;
      gap: 6px;
    }

    .tab-btn {
      background-color: var(--bg-color);
      color: var(--primary);
      border: 1px solid var(--primary);
      padding: 6px 14px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .tab-btn:hover,
    .tab-btn.active {
      background-color: var(--primary);
      color: #FBFAF4;
      border-color: var(--primary);
    }

    /* --- Section Styling --- */
    .section-block {
      margin-bottom: 40px;
    }

    .section-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 6px;
    }

    .section-title {
      font-size: 22px;
      font-weight: 700;
      color: var(--text-main);
    }

    .section-badge {
      font-size: 12px;
      font-weight: 600;
      padding: 2px 10px;
      border-radius: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .badge-edit {
      background-color: var(--pill-bg);
      color: var(--primary);
      border: 1px solid var(--border-color);
    }

    .badge-run {
      background-color: var(--callout-header);
      color: var(--text-main);
      border: 1px solid var(--border-color);
    }

    .section-description {
      font-size: 14px;
      color: var(--text-muted);
      margin-bottom: 20px;
    }

    /* --- Card Grid --- */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 22px;
    }

    /* Quarto Card Styling matching user guidelines */
    .quarto-grid-item.card {
      background-color: var(--card-bg);
      border-radius: 12px;
      border: 1px solid var(--border-color);
      transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .quarto-grid-item.card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-hover);
      background-color: var(--card-hover-bg);
      border-color: var(--primary-hover);
    }

    .card-header-bar {
      background-color: rgba(186, 223, 222, 0.35);
      border-bottom: 1px solid rgba(44, 160, 171, 0.3);
      padding: 12px 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .card-type-tag {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--primary);
    }

    .card-title {
      font-size: 17px;
      font-weight: 700;
      color: var(--text-main);
    }

    .card-body {
      padding: 20px 18px;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .card-text {
      font-size: 14px;
      color: var(--text-muted);
      margin-bottom: 20px;
    }

    /* Button Styling exactly matching Quarto user custom button CSS */
    .btn-outline-primary,
    .btn-outline-primary:visited {
      background-color: #FBFAF4 !important;
      color: #20808D !important;
      border: 1px solid #20808D !important;
      box-shadow: none !important;
      border-radius: 6px;
      padding: 8px 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-weight: 600;
      font-size: 13px;
      text-decoration: none !important;
      transition: all 0.2s ease-in-out;
      cursor: pointer;
      width: 100%;
    }

    .btn-outline-primary:hover,
    .btn-outline-primary:focus,
    .btn-outline-primary:active {
      background-color: #20B8CD !important;
      color: #FBFAF4 !important;
      border: 1px solid #20B8CD !important;
      text-decoration: none !important;
    }

    .btn-outline-primary svg {
      color: #20808D !important;
      fill: #20808D !important;
      transition: fill 0.2s ease, color 0.2s ease;
    }

    .btn-outline-primary:hover svg,
    .btn-outline-primary:focus svg,
    .btn-outline-primary:active svg {
      color: #FBFAF4 !important;
      fill: #FBFAF4 !important;
    }

    .btn-filled-primary {
      background-color: #20808D !important;
      color: #FBFAF4 !important;
      border: 1px solid #20808D !important;
      border-radius: 6px;
      padding: 8px 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-weight: 600;
      font-size: 13px;
      text-decoration: none !important;
      transition: all 0.2s ease-in-out;
      cursor: pointer;
      width: 100%;
    }

    .btn-filled-primary:hover,
    .btn-filled-primary:focus {
      background-color: #20B8CD !important;
      border-color: #20B8CD !important;
      color: #FBFAF4 !important;
      text-decoration: none !important;
    }

    .btn-filled-primary svg {
      fill: #FBFAF4 !important;
      color: #FBFAF4 !important;
    }

    /* --- Footer --- */
    footer {
      background-color: #FBFAF4;
      border-top: 1px solid var(--border-color);
      text-align: center;
      padding: 24px 0 10px;
      margin-top: auto;
      font-size: 13px;
      color: var(--text-muted);
    }

    footer p {
      margin-bottom: 8px;
    }

    footer a, footer a:visited {
      color: #20808D !important;
      text-decoration: none !important;
      transition: color 0.2s;
    }

    footer a:hover, footer a:focus {
      color: #1FB8CD !important;
      text-decoration: underline !important;
    }

    .footer-links {
      display: flex;
      justify-content: center;
      gap: 16px;
      margin: 10px 0;
    }

    .empty-state {
      display: none;
      text-align: center;
      padding: 40px 20px;
      color: var(--text-muted);
      font-size: 15px;
    }
  </style>
</head>
<body>
  <div class="container">
    
    <!-- Hero Header -->
    <header class="hero-banner">
      <div class="brand-row">
        <img src="https://raw.githubusercontent.com/marimo-team/marimo/main/docs/_static/marimo-logotype-thick.svg" alt="marimo Logo" class="logo">
        <span class="wasm-badge">WASM Powered</span>
      </div>
      <h1 class="hero-title">Interactive Notebooks & Applications</h1>
      <p class="subtitle">Interactive Python notebooks, presentation slides, and WebAssembly apps compiled for instant client-side execution in your browser.</p>
      
      <div class="features-row">
        <span class="feature-pill">⚡ Client-Side WebAssembly</span>
        <span class="feature-pill">📓 Reactive Python Edit Mode</span>
        <span class="feature-pill">📊 Interactive App & Slide Runs</span>
      </div>
    </header>

    <!-- Search & Filter Controls -->
    <div class="controls-bar">
      <div class="search-box">
        <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
        <input type="text" id="search-input" placeholder="Search notebooks and apps...">
      </div>
      <div class="filter-tabs">
        <button class="tab-btn active" data-filter="all">All</button>
        <button class="tab-btn" data-filter="notebook">Notebooks</button>
        <button class="tab-btn" data-filter="app">Apps & Slides</button>
      </div>
    </div>

    <main>
      {% if notebooks %}
      <!-- Notebooks Section -->
      <section class="section-block" id="notebooks-section">
        <div class="section-header">
          <h2 class="section-title">Notebooks</h2>
          <span class="section-badge badge-edit">Edit Mode</span>
        </div>
        <p class="section-description">Interactive notebooks in edit mode — modify Python code and experiment with live reactive execution.</p>
        
        <div class="cards-grid">
          {% for notebook in notebooks %}
          <div class="quarto-grid-item card item-card" data-type="notebook" data-title="{{ notebook.display_name | lower }}">
            <div class="card-header-bar">
              <span class="card-title">{{ notebook.display_name }}</span>
              <span class="card-type-tag">Interactive</span>
            </div>
            <div class="card-body">
              <p class="card-text">Live reactive Python environment with editable code blocks.</p>
              <a href="{{ notebook.html_path }}" class="btn-outline-primary">
                <svg width="14" height="14" viewBox="0 0 24 24"><path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/></svg>
                Open Notebook
              </a>
            </div>
          </div>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      {% if apps %}
      <!-- Apps Section -->
      <section class="section-block" id="apps-section">
        <div class="section-header">
          <h2 class="section-title">Apps & Presentations</h2>
          <span class="section-badge badge-run">Run Mode</span>
        </div>
        <p class="section-description">Interactive applications and presentation slides in run mode — code is hidden for a clean presentation interface.</p>
        
        <div class="cards-grid">
          {% for app in apps %}
          <div class="quarto-grid-item card item-card" data-type="app" data-title="{{ app.display_name | lower }}">
            <div class="card-header-bar">
              <span class="card-title">{{ app.display_name }}</span>
              <span class="card-type-tag">App / Slides</span>
            </div>
            <div class="card-body">
              <p class="card-text">Standalone WebAssembly interactive application / presentation.</p>
              <a href="{{ app.html_path }}" class="btn-filled-primary">
                <svg width="14" height="14" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                Launch App
              </a>
            </div>
          </div>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      <div class="empty-state" id="empty-state">
        <p>No notebooks or applications matched your search query.</p>
      </div>
    </main>

    <footer>
      <p>Built with <a href="https://marimo.io" target="_blank">marimo</a> & WebAssembly — Interactive Python Notebooks</p>
      <div class="footer-links">
        <a href="https://github.com/marimo-team/marimo" target="_blank">GitHub</a>
        <a href="https://docs.marimo.io" target="_blank">Documentation</a>
        <a href="https://discord.gg/JE7nhX6mD8" target="_blank">Discord</a>
      </div>
      <p>Licensed under <a href="https://github.com/marimo-team/marimo/blob/main/LICENSE" target="_blank">Apache License 2.0</a></p>
    </footer>

  </div>

  <!-- Interactive Filter & Search Script -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const searchInput = document.getElementById('search-input');
      const tabBtns = document.querySelectorAll('.tab-btn');
      const itemCards = document.querySelectorAll('.item-card');
      const notebooksSection = document.getElementById('notebooks-section');
      const appsSection = document.getElementById('apps-section');
      const emptyState = document.getElementById('empty-state');

      let currentFilter = 'all';
      let searchQuery = '';

      function filterItems() {
        let visibleCount = 0;
        let visibleNotebooks = 0;
        let visibleApps = 0;

        itemCards.forEach(card => {
          const type = card.getAttribute('data-type');
          const title = card.getAttribute('data-title');
          
          const matchesFilter = (currentFilter === 'all' || currentFilter === type);
          const matchesSearch = title.includes(searchQuery.toLowerCase());

          if (matchesFilter && matchesSearch) {
            card.style.display = 'flex';
            visibleCount++;
            if (type === 'notebook') visibleNotebooks++;
            if (type === 'app') visibleApps++;
          } else {
            card.style.display = 'none';
          }
        });

        if (notebooksSection) {
          notebooksSection.style.display = visibleNotebooks > 0 ? 'block' : 'none';
        }
        if (appsSection) {
          appsSection.style.display = visibleApps > 0 ? 'block' : 'none';
        }
        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      }

      tabBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          tabBtns.forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          currentFilter = this.getAttribute('data-filter');
          filterItems();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', function(e) {
          searchQuery = e.target.value.trim();
          filterItems();
        });
      }
    });
  </script>
</body>
</html>
